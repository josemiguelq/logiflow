NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logiflow

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Login com Google (OAuth Client ID do tipo "Web"). Mesmo valor do frontend
# (NEXT_PUBLIC_GOOGLE_CLIENT_ID). Usado para verificar o ID token no login/cadastro.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Produção: origens permitidas (várias separadas por vírgula).
# Dev: ignorado para CORS — qualquer origem é refletida (use CORS_STRICT=1 para testar como produção).
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
TRACKING_BASE_URL=http://localhost:3000/tracking

UPLOAD_DIR=./uploads

# ── WhatsApp Cloud API (Meta) — número central da LogiFlow (fase 1) ──
# Credenciais do WhatsApp Manager / Meta for Developers.
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_WABA_ID=your-whatsapp-business-account-id
# Segredo do App (Meta → Configurações do app) — valida a assinatura do webhook.
WHATSAPP_APP_SECRET=your-app-secret
# Token arbitrário que você define e repete no painel do webhook da Meta.
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
# Opcional — versão da Graph API (default v21.0).
WHATSAPP_GRAPH_VERSION=v21.0
